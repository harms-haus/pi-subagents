{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "Pi extension for spawning parallel sub-agents with live TUI windows",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": ["pi-package", "pi-extension", "subagent"],
  "author": "",
  "license": "MIT",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typebox": "^1.1.38",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "lint": "biome check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/"
  }
}
